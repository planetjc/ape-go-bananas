{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APE",
  "version": "0.2.0",
  "identifier": "com.ankiengine.ape",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare-bundle && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "A.P.E.",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' 'sha256-Vew5JXhdgrrWv5RqwD9RRFiBCjV8gGA59Li6e2UmSvY='; frame-src 'self' about: data:; child-src 'self' about: data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "resources/engine/": "engine/",
      "resources/package.json": "package.json",
      "resources/npm/": "npm/",
      "resources/method/": "method/"
    },
    "macOS": {
      "bundleName": "A.P.E.",
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4MkZFQzEwOTNCNkY5RkUKUldUKytiYVRFT3d2YUJXY3NkdmpydHhHeFZrSVVnRUNReTNtdEJtbzR4NWFnMHhNa3FRLytSTlQK",
      "endpoints": [
        "https://ankiengine.com/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
